#!/bin/bash
set -eu

readonly IMAGE="${NVIM_CONTAINER_IMAGE:-ghcr.io/kihachi2000/neovim-container:latest}"
readonly CONTAINER_HOME="/tmp/nvim-home"
readonly CONTAINER_XDG_CONFIG_HOME="/tmp/nvim-config"

usage() {
  cat <<'EOF' >&2
Usage: nv-debug <config-dir> [-- [neovim-options] [file]]
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage
    exit 1
    ;;
esac

CONFIG_DIR="$1"
shift

if [ ! -d "${CONFIG_DIR}" ]; then
  echo "config directory does not exist: ${CONFIG_DIR}" >&2
  exit 1
fi

# consume optional '--' separator
if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
  shift
fi

readonly CONFIG_DIR_ABS="$(cd "${CONFIG_DIR}" && pwd)"

declare -a DOCKER_OPTIONS=(
  "--rm"
  "-e" "HOME=${CONTAINER_HOME}"
  "-e" "XDG_CONFIG_HOME=${CONTAINER_XDG_CONFIG_HOME}"
  "-v" "${PWD}:${PWD}"
  "-v" "${HOME}/.local/share/nvim:${CONTAINER_HOME}/.local/share/nvim"
  "-v" "${HOME}/.local/state/nvim:${CONTAINER_HOME}/.local/state/nvim"
  "-v" "${HOME}/.cache/nvim:${CONTAINER_HOME}/.cache/nvim"
  "-v" "${CONFIG_DIR_ABS}:${CONTAINER_XDG_CONFIG_HOME}/nvim"
  "-w" "${PWD}"
)

# Create the directory specified by the -v option in advance.
# Without doing so, Docker will create it with the Docker daemon's user as the owner.
# If the user running the Docker daemon differs from the user running the nv command,
# you will no longer be able to access these directories.
for directory in \
  "${HOME}/.local/share/nvim" \
  "${HOME}/.local/state/nvim" \
  "${HOME}/.cache/nvim"
do
  mkdir -p "${directory}"
done

# Change the user ID for non-Mac devices.
if [ "$(uname -s)" != "Darwin" ]; then
  DOCKER_OPTIONS+=("-u" "$(id -u):$(id -g)")
fi

# Add -it when running interactively.
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_OPTIONS+=("-it")
fi

exec docker run "${DOCKER_OPTIONS[@]}" "${IMAGE}" "$@"
