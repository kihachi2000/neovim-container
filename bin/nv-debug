#!/bin/sh
set -eu

IMAGE="${NVIM_CONTAINER_IMAGE:-ghcr.io/kihachi2000/neovim-container:latest}"

usage() {
  cat <<'EOF' >&2
Usage: nv-debug <config-dir> [-- [neovim-options] [file]]
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage
    exit 1
    ;;
esac

CONFIG_DIR="$1"
shift

if [ ! -d "${CONFIG_DIR}" ]; then
  echo "config directory does not exist: ${CONFIG_DIR}" >&2
  exit 1
fi

# consume optional '--' separator
if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
  shift
fi

CONFIG_DIR_ABS="$(cd "${CONFIG_DIR}" && pwd)"

if [ -t 0 ] && [ -t 1 ]; then
  docker run -it --rm \
    -u "$(id -u):$(id -g)" \
    -e "XDG_CONFIG_HOME=/tmp/nvim-config" \
    -v "${CONFIG_DIR_ABS}:/tmp/nvim-config/nvim" \
    -v "${PWD}:/workspace" \
    -w /workspace \
    "${IMAGE}" "$@"
else
  docker run --rm \
    -u "$(id -u):$(id -g)" \
    -e "XDG_CONFIG_HOME=/tmp/nvim-config" \
    -v "${CONFIG_DIR_ABS}:/tmp/nvim-config/nvim" \
    -v "${PWD}:/workspace" \
    -w /workspace \
    "${IMAGE}" "$@"
fi
